flowchart TD
  A["Captain opens a court"] --> B{"Has a team?"}
  B -- No --> C["Create a team"]
  B -- Yes --> D{"Roster READY and court compatible?"}
  D -- No --> E["Show reason and team management link"]
  D -- Yes --> F{"Within mock 50 m range?"}
  F -- No --> G["Block queue entry"]
  F -- Yes --> H{"Any active queue entry?"}
  H -- Yes --> I["Open current court; leave first"]
  H -- No --> J["Append WAITING entry"]
  J --> K["Lock roster editing"]
  K --> L{"Captain leaves while leaveable?"}
  L -- Yes --> M["Remove entry and reorder positions"]
  M --> N["Unlock roster editing"]
  L -- No --> O["Keep active entry"]
