digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad=0.3, nodesep=0.28, ranksep=0.42];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10.5, color="#215c3d", fillcolor="#f7faf7", margin="0.12,0.08"];
  edge [color="#607568", fontname="Arial", fontsize=9, arrowsize=0.7];
  start [label="สร้างทีม", fillcolor="#d5f26f"];
  full [label="สมาชิกครบหรือไม่?", shape=diamond, fillcolor="#fff1d3"];
  edit [label="หัวหน้าเพิ่ม/ลบสมาชิก"];
  choose [label="เลือกสนาม 3x3 A / 3x3 B / 5x5"];
  validate [label="สนามเปิด + ปฏิทินอนุญาต\n+ ตำแหน่งผ่านหรือไม่?", shape=diamond, fillcolor="#fff1d3"];
  reject [label="ปฏิเสธ พร้อมแสดงเหตุผล", fillcolor="#fde4df", color="#ad3c2c"];
  queue [label="เข้าคิวของสนามที่เลือก"];
  called [label="ระบบเรียกเมื่อถึงคิว"];
  checkin [label="เช็กอินครบในเวลาหรือไม่?", shape=diamond, fillcolor="#fff1d3"];
  missed [label="พลาดคิว และเรียกทีมถัดไป", fillcolor="#fde4df", color="#ad3c2c"];
  game [label="เริ่มเกม", fillcolor="#d9ecdf"];
  score [label="หัวหน้าทั้งสองทีม\nกรอกคะแนนทีมตนเอง"];
  validscore [label="คะแนนตรวจสอบได้หรือไม่?", shape=diamond, fillcolor="#fff1d3"];
  fix [label="แจ้งให้แก้ไขคะแนน"];
  result [label="คำนวณผู้ชนะ\nและบันทึกสถิติ", fillcolor="#d9ecdf"];
  streak [label="ชนะครบ 2 เกมหรือยัง?", shape=diamond, fillcolor="#fff1d3"];
  stay [label="ทีมชนะเล่นต่อ"];
  rest [label="แชมป์พัก 1 เกม"];
  two [label="สองทีมใหม่ขึ้นเล่น"];
  return [label="แชมป์กลับมาเป็นทีมถัดไป"];
  decide [label="ทีมแพ้ตัดสินใจ 3 นาที"];
  requeue [label="เลือกต่อท้ายคิวหรือไม่?", shape=diamond, fillcolor="#fff1d3"];
  tail [label="ต่อท้ายคิวเดิม"];
  leave [label="ออกจากคิว", fillcolor="#eef0ee"];

  start -> full;
  full -> edit [label="ไม่ครบ"];
  edit -> full;
  full -> choose [label="ครบ"];
  choose -> validate;
  validate -> reject [label="ไม่ผ่าน"];
  validate -> queue [label="ผ่าน"];
  queue -> called -> checkin;
  checkin -> missed [label="ไม่ครบ"];
  checkin -> game [label="ครบ"];
  game -> score -> validscore;
  validscore -> fix [label="ไม่ได้"];
  fix -> score;
  validscore -> result [label="ได้"];
  result -> streak;
  streak -> stay [label="ยัง"];
  streak -> rest [label="ครบ"];
  rest -> two -> return;
  result -> decide -> requeue;
  requeue -> tail [label="ใช่"];
  requeue -> leave [label="ไม่ / หมดเวลา"];
}
