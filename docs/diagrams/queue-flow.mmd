flowchart TD
  GAME["PLAYING"] --> END["END_REQUESTED"] --> SCORE["AWAITING_SCORE"] --> COMPLETE["COMPLETED"]
  COMPLETE --> WIN_DECIDE["DECIDING_CONTINUE"]
  WIN_DECIDE -->|Continue| HOLD["HOLDING_COURT"]
  WIN_DECIDE -->|Stop / 3-minute timeout| LEFT
  COMPLETE --> DECIDE["DECIDING_REQUEUE"]
  COMPLETE --> CLOSE_CHECKIN["Remove active check-in game and PLAYING sessions"]
  HOLD -->|First ready challenger| GAME
  COMPLETE --> REST["RESTING after second win"] -->|Rest game ends| HEAD["WAITING at queue head"]
  DECIDE -->|Requeue| WAIT["WAITING"]
  DECIDE -->|Leave / timeout| LEFT["LEFT_QUEUE"]
  A[สร้างทีม] --> B{สมาชิกครบหรือไม่}
  B -- ไม่ครบ --> C[หัวหน้าเพิ่ม/ลบสมาชิก]
  C --> B
  B -- ครบ --> D[เลือกสนาม]
  D --> E{ผู้เล่นอยู่ใกล้สนามและสนามเปิดหรือไม่}
  ADMIN[Admin เปิด/ปิดสนามและจัดการกิจกรรม] --> E
  ADMIN --> TARGET[ตั้งคะแนนเป้าหมายรายวัน]
  TARGET --> K
  E -- ไม่ผ่าน --> F[ปฏิเสธการเข้าคิว พร้อมเหตุผล]
  E -- ผ่าน --> G[เข้าคิวของสนามที่เลือก]
  G --> H[ระบบเรียกอัตโนมัติทุก 30 วินาที เมื่อมีทีมพอเล่น]
  H --> I{เช็กอินครบในเวลาหรือไม่}
  I -- ไม่ครบ --> J[พลาดคิวและเรียกทีมถัดไป]
  I -- ครบ --> K[เริ่มเกม]
  K --> L[หัวหน้าทั้งสองทีมกรอกคะแนนทีมตนเอง]
  L --> M{คะแนนตรวจสอบได้หรือไม่}
  M -- ไม่ได้ --> N[แจ้งให้แก้ไขคะแนน]
  N --> L
  M -- ได้ --> O[คำนวณผู้ชนะและบันทึกสถิติ]
  O --> P{ทีมชนะครบ 2 เกมหรือยัง}
  P -- ยัง --> Q[ทีมชนะเลือกเล่นต่อภายใน 3 นาที เจอทีมแรกที่พร้อม]
  P -- ครบ --> R[ทีมชนะพัก 1 เกม]
  R --> S[สองทีมจากคิวขึ้นเล่น]
  S --> T[แชมป์กลับมาเป็นคิวแรก]
  O --> U[ทีมแพ้ตัดสินใจ 3 นาที]
  U --> V{เลือกต่อท้ายคิวหรือไม่}
  V -- ใช่ --> W[ต่อท้ายคิวเดิม]
  V -- ไม่ / หมดเวลา --> X[ออกจากคิว]
